{
  "name": "@rome-protocol/sdk",
  "version": "0.3.0",
  "description": "Rome Protocol TypeScript SDK — submitRomeTx, submitRomeTxV1, PDA/ATA derivation, and CPI calldata encoding.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@scure/base": "^1.2.6"
  }
}
